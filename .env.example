# Copia este archivo a .env y llénalo. `bun run pb` lo carga solo.

# URL pública de PocketBase (la que ve el navegador). Google redirige aquí.
APP_URL=http://127.0.0.1:8093
# Dónde está la web. En desarrollo Vite corre en 3434; en producción es la misma APP_URL.
WEB_URL=http://localhost:3434

# Cliente OAuth de Google (Gmail API, solo lectura). Ver README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
