# Variables opcionales para desarrollo. Copia este archivo a .env y cambia
# solo lo que necesites: Bun lo carga solo con `bun run dev` y `bun run seed`.
# En producción no hace falta: la imagen de Docker no usa ninguna.

# Dónde escucha PocketBase (la API) en desarrollo.
# PB_HTTP=127.0.0.1:8093

# A qué PocketBase envía Vite las peticiones de /api y /_, y a cuál carga
# `bun run seed` los datos de ejemplo. Debe coincidir con PB_HTTP.
# PB_URL=http://127.0.0.1:8093

# Puerto de la web en desarrollo (Vite).
# WEB_PORT=3434

# Dirección de PocketBase que usa la web compilada. Vacío: la misma dirección
# desde donde se abre la página, que es lo normal en producción.
# VITE_PB_URL=
